<Project Sdk="Microsoft.NET.Sdk">
  <!-- Revit 2026 only. 2026.5 runs on .NET 10, 2026.4 and older on .NET 8: both are built from this
       source, and the build deploys the one that matches the installed Revit. The reference DLLs of
       each line live in C:\RevitRefs\2026.4 and C:\RevitRefs\2026.5 (RevitAPI.dll, RevitAPIUI.dll). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WallDivide</AssemblyName>
    <RootNamespace>WallDivide</RootNamespace>
    <RevitRefsDir Condition="'$(RevitRefsDir)' == ''">C:\RevitRefs</RevitRefsDir>
    <RevitInstallDir>C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
    <AddinsDir>$(APPDATA)\Autodesk\Revit\Addins\2026\</AddinsDir>
    <InstalledIsNet10 Condition="Exists('$(RevitInstallDir)\RevitAPI.runtimeconfig.json') AND $([System.IO.File]::ReadAllText('$(RevitInstallDir)\RevitAPI.runtimeconfig.json').Contains('net10.0'))">true</InstalledIsNet10>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="RevitAPI"><HintPath>$(RevitRefsDir)\2026.4\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitRefsDir)\2026.4\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Reference Include="RevitAPI"><HintPath>$(RevitRefsDir)\2026.5\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitRefsDir)\2026.5\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copy the build that matches the installed Revit into the add-ins folder (pass -p:Deploy=false to skip) -->
  <Target Name="DeployMatching" AfterTargets="Build"
          Condition="'$(Deploy)' != 'false' AND (('$(TargetFramework)' == 'net10.0-windows' AND '$(InstalledIsNet10)' == 'true') OR ('$(TargetFramework)' == 'net8.0-windows' AND '$(InstalledIsNet10)' != 'true'))">
    <ItemGroup>
      <DeployFiles Include="$(OutDir)WallDivide.dll;$(OutDir)WallDivide.pdb;$(OutDir)WallDivide.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(AddinsDir)WallDivide\" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\WallDivide.addin" DestinationFolder="$(AddinsDir)" />
    <Message Importance="high" Text="Deployed $(TargetFramework) to $(AddinsDir)" />
  </Target>
</Project>
